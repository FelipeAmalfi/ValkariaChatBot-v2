{
  "name": "@valkaria/chat-service",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "sh -c 'set -a && . ../../.env && set +a && tsx watch src/index.ts'",
    "start": "node dist/index.js",
    "test": "vitest run",
    "graph:dev": "tsx src/interface/graph/repl.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^10.1.0",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.0",
    "@valkaria/config": "*",
    "@valkaria/database": "*",
    "@valkaria/domain": "*",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "mercurius": "16.9.0",
    "neo4j-driver": "^5.28.3",
    "openai": "^6.39.1",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.22.3",
    "vitest": "^3.2.4"
  }
}
